# Keiki API key (Keiki dashboard -> API keys)
KEIKI_API_KEY=
# The Keiki phone line the agent texts from, E.164 (e.g. +14155551234)
KEIKI_PHONE_LINE=
# Convex HTTP actions base URL (Convex dashboard -> Settings -> URL & Deploy Key), ends in .convex.site
CONVEX_SITE_URL=https://your-deployment.convex.site
# Must match KEIKI_SHARED_SECRET set in the Convex environment; sent as the x-practify-key header
KEIKI_SHARED_SECRET=
